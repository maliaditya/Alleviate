{
  "name": "alleviate-canvas",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync:excalidraw-assets": "node scripts/sync-excalidraw-assets.cjs",
    "predev": "npm run sync:excalidraw-assets",
    "prebuild": "npm run sync:excalidraw-assets",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.17.6",
    "@supabase/supabase-js": "^2.109.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-pdf": "^9.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "typescript": "^5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.alleviate.life",
    "productName": "Alleviate",
    "icon": "electron/assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/assets/icon.ico",
      "package.json",
      "electron/preload.cjs"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/server-bootstrap.cjs",
        "to": "app/desktop-server-bootstrap.cjs"
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Alleviate-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerHeaderIcon": "electron/assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alleviate"
    }
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^14.2.33"
  }
}
